# ReTryPay Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local environment.

# Core Application Environment
# Permitted values: test | development | demo
# NOTE: live mode is strictly prohibited in this codebase.
RETRYPAY_ENV=test
DEBUG=false

# Database Configuration (Async SQLite default for local development & test)
DATABASE_URL=sqlite+aiosqlite:///./retrypay.db

# Razorpay Test Mode Credentials
# RAZORPAY_KEY_ID must begin with 'rzp_test_'. Any key starting with 'rzp_live_' is rejected at startup.
RAZORPAY_PROVIDER_ENABLED=false
RAZORPAY_TEST_MODE_ONLY=true
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=retrypay_dev_webhook_secret_key_123

# LLM / Structured Failure Diagnosis Adapter Configuration (Gemini)
# Set LLM_ENABLED=true to enable Gemini structured failure diagnosis.
# When LLM_ENABLED=false (default safe mode), RulesDiagnosisAdapter is used with zero external network calls.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_TIMEOUT_SECONDS=5
# Required only when LLM_ENABLED=true and LLM_PROVIDER=gemini:
GEMINI_API_KEY=placeholder_gemini_api_key

# Privacy & Compliance Flags
# RETRYPAY_RETAIN_RAW_WEBHOOK_PAYLOAD can only be true when RETRYPAY_ENV=test.
RETRYPAY_RETAIN_RAW_WEBHOOK_PAYLOAD=false

# Recovery Policy Defaults
RETRYPAY_POLICY_VERSION=recovery-v1.3
RETRYPAY_MAX_AUTO_RECOVERY_PAISE=1000000
RETRYPAY_MAX_MSGS_PER_ORDER=2
RETRYPAY_MAX_MSGS_PER_CUSTOMER_30D=3
RETRYPAY_QUIET_HOURS_START=22:00
RETRYPAY_QUIET_HOURS_END=08:00
RETRYPAY_MERCHANT_TIMEZONE=Asia/Kolkata

# Attribution Reconciliation Window
RETRYPAY_ATTRIBUTION_RECONCILIATION_WINDOW_MINUTES=30
